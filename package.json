{
	"name": "slider-block",
	"version": "1.4.0",
	"description": "Display Multiple Images In Beautiful Slider & Reduce Page Scroll",
	"author": "WPDeveloper",
	"license": "GPL-3.0-or-later",
	"main": "Gruntfile.js",
	"engines": {
		"node": ">=22",
		"npm": ">=10"
	},
	"scripts": {
		"postinstall": "npm run submodules && npm run install:controls",
		"submodules": "git submodule update --init --recursive",
		"install:controls": "npm --prefix controls install --force --no-audit --no-fund",
		"start": "npm run build:controls && wp-scripts start",
		"build": "npm run build:controls && wp-scripts build",
		"build:controls": "npm --prefix controls run build",
		"packages-update": "wp-scripts packages-update"
	},
	"devDependencies": {
		"@babel/core": "^7.16.5",
		"@babel/plugin-proposal-class-properties": "^7.16.5",
		"@babel/preset-env": "^7.16.5",
		"@babel/preset-react": "^7.16.5",
		"@wordpress/block-editor": "^12.23.0",
		"@wordpress/blocks": "^12.32.0",
		"@wordpress/components": "^27.3.0",
		"@wordpress/compose": "^6.32.0",
		"@wordpress/data": "^9.25.0",
		"@wordpress/element": "^5.32.0",
		"@wordpress/i18n": "^4.55.0",
		"@wordpress/scripts": "^27.6.0",
		"babel-loader": "^8.2.3",
		"lodash": "^4.17.21",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"dependencies": {
		"react-slick": "^0.30.3",
		"slick-carousel": "^1.8.1",
		"classnames": "^2.3.1"
	}
}
