# Files excluded from the WordPress.org distribution.
#
# Consumed by 10up/action-wordpress-plugin-deploy (.github/workflows/deploy.yml)
# via `rsync --exclude-from`, and by `wp dist-archive` for local builds.
# Patterns without a slash match by basename at any depth.
#
# Do NOT add: block.json, dist/, includes/, lib/, readme.txt, slider-block.php
# — all four are required at runtime.

# -- Version control & repo metadata --
.git
.gitignore
.gitmodules
.gitattributes
.github
.gitlab-ci.yml

# -- CI / build pipelines --
.circleci
.travis.yml
bitbucket-pipelines.yml
behat.yml
dependencies.yml
wp-cli.local.yml
bin

# -- Packaging control files --
.distignore
.deployignore
.wordpress-org

# -- Node / package manifests & lockfiles --
package.json
package-lock.json
yarn.lock
pnpm-lock.yaml
node_modules
.npmrc
.nvmrc

# -- PHP dependency manifests --
composer.json
composer.lock
vendor

# -- Babel --
.babelrc
.babelrc.js
.babelrc.cjs
.babelrc.mjs
.babelrc.json
babel.config.js
babel.config.cjs
babel.config.mjs
babel.config.json

# -- Bundler / build configuration --
webpack.config.js
webpack.config.babel.js
Gruntfile.js
gulpfile.js
rollup.config.js
vite.config.js
postcss.config.js
tailwind.config.js
tsconfig.json
jsconfig.json
config

# -- Linters & formatters --
.eslintrc
.eslintrc.js
.eslintrc.json
.eslintrc.yml
.eslintignore
.eslintcache
.prettierrc
.prettierrc.js
.prettierrc.json
.prettierignore
.stylelintrc
.stylelintrc.json
.editorconfig
.phpcs.xml
.phpcs.xml.dist
phpcs.xml
phpcs.xml.dist
phpstan.neon
phpstan.neon.dist

# -- Tests --
tests
phpunit.xml
phpunit.xml.dist
multisite.xml
multisite.xml.dist
.phpunit.result.cache

# -- Sources (compiled into dist/ at build time) --
src
controls
lib/style-handler/style-handler.js
lib/style-handler/helpers.js

# -- Source maps: dev-only, never referenced by the shipped plugin --
*.map

# -- Documentation not shipped to WP.org (readme.txt is the exception) --
README.md
*.md

# -- Editor & OS cruft --
.idea
.vscode
.claude
.cursor
.DS_Store
Thumbs.db
desktop.ini

# -- Environment & logs --
.env
.env.*
*.log
logs
coverage

# -- Archives & dumps --
*.zip
*.tar.gz
*.tgz
*.sql
